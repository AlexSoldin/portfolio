{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  // Enable workers.dev subdomain (portfolio.alex-soldin.workers.dev)
  "workers_dev": true,
  // Enable preview URLs for testing deployments
  "preview_urls": true,
  // Custom domain routes
  "routes": [
    {
      "pattern": "soldin.co",
      "zone_name": "soldin.co",
    },
    {
      "pattern": "www.soldin.co",
      "zone_name": "soldin.co",
    },
  ],
  // Static assets binding (Astro output)
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
  },
  // Enable observability for logs and monitoring
  "observability": {
    "enabled": true,
  },
  // Environment variables
  "vars": {
    "NODE_ENV": "production",
  },
}
