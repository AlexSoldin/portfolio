---
import { socials } from "@/data/socials";

const year = new Date().getFullYear();
---

<footer class="w-full mt-auto p-8 md:p-12">
  <nav
    class="flex flex-col md:flex-row w-full items-center justify-between border-t border-[var(--border)] pt-8 gap-6 md:gap-0"
  >
    <div class="text-xs font-mono text-[var(--muted)]">
      <span>&copy; {year} Alex Soldin</span>
    </div>
    <div
      class="flex flex-wrap items-center justify-center gap-x-8 gap-y-6 text-xs font-mono uppercase tracking-wider text-[var(--muted)]"
    >
      {
        socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="pressable tap-target hover-underline whitespace-nowrap"
          >
            {social.name}
          </a>
        ))
      }
    </div>
  </nav>
</footer>
