---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  text?: string;
}

const { text = "Design • Create • Iterate" } = Astro.props;
---

<div
  class="w-24 h-24 border border-(--border) rounded-full flex items-center justify-center relative"
>
  <svg
    class="w-full h-full absolute inset-0 text-(--foreground) opacity-80 animate-spin-slow"
    viewBox="0 0 100 100"
    aria-hidden="true"
  >
    <defs>
      <path
        d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"
        fill="transparent"
        id="badge-curve"></path>
    </defs>
    <text class="font-mono text-[10px] uppercase tracking-[0.2em]" fill="currentColor">
      <textPath href="#badge-curve" startOffset="0%">{text}</textPath>
    </text>
  </svg>
  <div
    class="w-16 h-16 rounded-full border border-(--border) flex items-center justify-center bg-(--foreground)/5 backdrop-blur-sm"
  >
    <Icon name="code" class="size-6 text-(--foreground)" />
  </div>
</div>
