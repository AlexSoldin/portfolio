---
// Dots drift in a loose scatter, ease into a grid, hold, then loosen again.
// Pure CSS: positions are generated here with a seeded PRNG so every render is identical.
const COLUMNS = 16;
const ROWS = 9;

function createRandom(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = createRandom(20260924);

const dots = Array.from({ length: COLUMNS * ROWS }, (_, index) => {
  const x = 8 + (index % COLUMNS) * (84 / (COLUMNS - 1));
  const y = 12 + Math.floor(index / COLUMNS) * (76 / (ROWS - 1));
  const scatterX = 4 + random() * 92;
  const scatterY = 6 + random() * 88;
  return {
    style: [
      `left: ${x.toFixed(2)}%`,
      `top: ${y.toFixed(2)}%`,
      `--dx: ${(scatterX - x).toFixed(2)}cqw`,
      `--dy: ${(scatterY - y).toFixed(2)}cqh`,
      `--delay: ${Math.round(random() * -600)}ms`,
    ].join("; "),
  };
});
---

<div class="noise-to-order" aria-hidden="true">
  {dots.map((dot) => <span class="dot" style={dot.style} />)}
</div>

<style>
  .noise-to-order {
    position: relative;
    container-type: size;
    width: 100%;
    height: 100%;
  }

  .dot {
    position: absolute;
    width: 3px;
    height: 3px;
    margin: -1.5px 0 0 -1.5px;
    border-radius: 9999px;
    background: var(--foreground);
    animation: settle 10s var(--ease-in-out) var(--delay) infinite;
  }

  /* scattered → (move) → grid → hold → (move) → scattered */
  @keyframes settle {
    0%,
    15% {
      transform: translate(var(--dx), var(--dy));
      opacity: 0.3;
    }
    45%,
    75% {
      transform: translate(0, 0);
      opacity: 0.8;
    }
    100% {
      transform: translate(var(--dx), var(--dy));
      opacity: 0.3;
    }
  }

  /* Reduced motion: show the settled grid, no movement */
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
      opacity: 0.6;
    }
  }
</style>
