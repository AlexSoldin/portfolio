---
// Dots drift loose, settle into a grid, reassemble as a high-pass filter, then loosen again.
// Pure CSS: every dot's positions are generated here from a fixed seed, so renders are identical.
import {
  createRandom,
  gridPoints,
  highPassLabels,
  highPassPoints,
  scatterPoints,
} from "./dotShapes";

const COLUMNS = 16;
const ROWS = 9;
const COUNT = COLUMNS * ROWS;

const random = createRandom(20260924);
const scatter = scatterPoints(COUNT, random);
const grid = gridPoints(COLUMNS, ROWS);
const circuit = highPassPoints(COUNT);
const labels = highPassLabels();

const dots = grid.map((gridPoint, index) =>
  [
    `--sx: ${scatter[index].x.toFixed(2)}cqw`,
    `--sy: ${scatter[index].y.toFixed(2)}cqh`,
    `--gx: ${gridPoint.x.toFixed(2)}cqw`,
    `--gy: ${gridPoint.y.toFixed(2)}cqh`,
    `--cx: ${circuit[index].x.toFixed(2)}cqw`,
    `--cy: ${circuit[index].y.toFixed(2)}cqh`,
    `--delay: ${Math.round(random() * -600)}ms`,
  ].join("; ")
);
---

<div class="noise-to-order" aria-hidden="true">
  {dots.map((style) => <span class="dot" style={style} />)}
  {
    labels.map((label) => (
      <span class="label font-mono" style={`left: ${label.x}%; top: ${label.y}%`}>
        {label.text}
      </span>
    ))
  }
</div>

<style>
  .noise-to-order {
    position: relative;
    container-type: size;
    width: 100%;
    height: 100%;
  }

  .dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 3px;
    margin: -1.5px 0 0 -1.5px;
    border-radius: 9999px;
    background: var(--foreground);
    animation: morph 15s var(--ease-in-out) var(--delay) infinite;
  }

  .label {
    position: absolute;
    transform: translate(-50%, -50%);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--muted);
    opacity: 0;
    animation: label 15s ease infinite;
  }

  /* loose → grid → high-pass filter (longest hold) → loose */
  @keyframes morph {
    0%,
    6%,
    94%,
    100% {
      transform: translate(var(--sx), var(--sy));
      opacity: 0.3;
    }
    20%,
    34% {
      transform: translate(var(--gx), var(--gy));
      opacity: 0.6;
    }
    48%,
    80% {
      transform: translate(var(--cx), var(--cy));
      opacity: 0.9;
    }
  }

  /* Labels appear once the circuit has formed and leave before it breaks up */
  @keyframes label {
    0%,
    50%,
    80%,
    100% {
      opacity: 0;
    }
    54%,
    76% {
      opacity: 1;
    }
  }

  /* Reduced motion: show the finished circuit, no movement */
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
      transform: translate(var(--cx), var(--cy));
      opacity: 0.8;
    }

    .label {
      animation: none;
      opacity: 1;
    }
  }
</style>
