---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  href?: string;
  text?: string;
  slot?: string;
}

const { href = "/", text = "Back to home", slot = "nav" } = Astro.props;
---

<a
  slot={slot}
  class="group pressable tap-target hover-underline text-[10px] uppercase tracking-widest flex items-center gap-1"
  href={href}
>
  <Icon
    name="arrow-west"
    class="size-3.5 motion-safe:group-hover:-translate-x-1 transition-transform duration-200 ease-(--ease-out)"
  />
  {text}
</a>
