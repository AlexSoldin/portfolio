---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  href?: string;
  text?: string;
  slot?: string;
}

const { href = "/", text = "Back to home", slot = "nav" } = Astro.props;
---

<a
  slot={slot}
  class="text-[10px] uppercase tracking-widest hover-underline flex items-center gap-1 group"
  href={href}
>
  <Icon
    name="arrow-west"
    class="size-3.5 group-hover:translate-x-[-4px] transition-transform duration-200 ease-(--ease-out)"
  />
  {text}
</a>
