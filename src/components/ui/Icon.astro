---
const paths = {
  "arrow-north-east": "M7 17 17 7M8 7h9v9",
  "arrow-west": "M19 12H5m6 6-6-6 6-6",
  code: "m8 7-5 5 5 5m8-10 5 5-5 5",
} as const;

interface Props {
  name: keyof typeof paths;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
