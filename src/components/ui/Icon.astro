---
const paths = {
  "arrow-east": "M5 12h14m-6-6 6 6-6 6",
  "arrow-west": "M19 12H5m6 6-6-6 6-6",
} as const;

interface Props {
  name: keyof typeof paths;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
