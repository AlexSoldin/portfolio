---
import NoiseToOrder from "@/components/features/home/NoiseToOrder.astro";
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Alex Soldin" showFooter={true}>
  <main class="relative z-10 flex-1 flex flex-col items-center justify-center px-6 pt-16 pb-16">
    <div class="flex flex-col items-center w-full max-w-4xl mx-auto text-center">
      <h1
        style="--i: 0"
        class="hero-enter font-serif text-4xl md:text-6xl lg:text-7xl italic leading-tight tracking-[-0.01em] text-(--foreground) z-20"
      >
        <span class="md:block">First, understand the problem.</span> Then, build what matters.
      </h1>

      <div style="--i: 1" class="hero-enter mt-10 w-full max-w-2xl">
        <NoiseToOrder />
      </div>

      <div
        style="--i: 2"
        class="hero-enter mt-8 font-mono text-xs uppercase tracking-widest text-(--foreground) flex gap-8"
      >
        {
          [
            { href: "/about", label: "About" },
            { href: "/contact", label: "Get in touch" },
          ].map(({ href, label }) => (
            <a
              class="group pressable tap-target hover-underline flex items-center gap-2"
              href={href}
            >
              <Icon
                name="arrow-east"
                class="size-4 motion-safe:group-hover:translate-x-1 transition-transform duration-200 ease-(--ease-out)"
              />
              {label}
            </a>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* First-load entrance: each hero block fades up, 60ms apart */
  .hero-enter {
    animation: hero-enter 400ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms);
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes hero-enter-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation-name: hero-enter-fade;
    }
  }
</style>
