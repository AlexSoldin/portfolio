---
import NoiseToOrder from "@/components/features/home/NoiseToOrder.astro";
import RotatingBadge from "@/components/features/home/RotatingBadge.astro";
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Alex Soldin" showFooter={true}>
  <main class="relative z-10 flex-1 flex flex-col items-center justify-center px-6 pt-16 pb-16">
    <div class="flex flex-col items-center gap-8 md:gap-12 w-full max-w-4xl mx-auto text-center">
      <div class="hero-enter" style="--i: 0">
        <RotatingBadge />
      </div>

      <div class="relative w-full flex flex-col items-center">
        <h1
          style="--i: 1"
          class="hero-enter font-serif text-4xl md:text-6xl lg:text-7xl italic leading-tight text-(--foreground) z-20 max-w-2xl"
        >
          First, understand the problem. Then, build what matters.
        </h1>

        <div
          style="--i: 2"
          class="hero-enter mt-8 w-full max-w-md aspect-[4/3] md:aspect-[16/9] rounded-sm border border-(--border) bg-(--foreground)/[0.02]"
        >
          <NoiseToOrder />
        </div>

        <div
          style="--i: 3"
          class="hero-enter mt-8 font-mono text-xs uppercase tracking-widest text-(--foreground) flex gap-8"
        >
          <a class="flex items-center gap-2 hover:opacity-60 transition-opacity" href="/about">
            <Icon name="arrow-north-east" />
            About
          </a>
          <a class="flex items-center gap-2 hover:opacity-60 transition-opacity" href="/contact">
            <Icon name="arrow-north-east" />
            Get in touch
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* First-load entrance: each hero block fades up, 60ms apart */
  .hero-enter {
    animation: hero-enter 600ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms);
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes hero-enter-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation-name: hero-enter-fade;
    }
  }
</style>
