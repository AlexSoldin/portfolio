---
import ProblemDiagram from "@/components/features/problems/ProblemDiagram.astro";
import BackButton from "@/components/ui/BackButton.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHero from "@/components/ui/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProblems } from "@/utils/problems";
import "@/styles/features/problems.css";

export const prerender = true;

const problems = await getProblems();
---

<BaseLayout title="Problems | Alex Soldin" showFooter={true}>
  <BackButton slot="nav" href="/problems" text="All layouts" />

  <main class="relative z-10 flex-1 flex flex-col items-center px-6 pt-16 pb-16">
    <div class="w-full max-w-6xl mx-auto">
      <PageHero title="Problems" />

      <div class="py-16 md:py-24 space-y-32">
        {
          problems.map((problem) => (
            <section aria-labelledby={`${problem.id}-title`}>
              <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-end">
                <h2
                  id={`${problem.id}-title`}
                  class="md:col-span-7 font-serif italic text-4xl md:text-5xl leading-[1.05] tracking-tight text-balance"
                >
                  {problem.data.title}
                </h2>
                <p class="md:col-span-5 font-light leading-relaxed text-(--muted)">
                  {problem.data.summary}
                </p>
              </div>

              <div class="mt-10 border border-(--border) p-6 md:p-10">
                <ProblemDiagram diagram={problem.data.diagram} />
              </div>

              <div class="mt-10 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
                <ul class="md:col-span-9 grid grid-cols-1 sm:grid-cols-3 gap-6">
                  {problem.data.outcomes.map((outcome) => (
                    <li class="pt-4 border-t border-(--foreground)/40 font-light leading-relaxed">
                      {outcome}
                    </li>
                  ))}
                </ul>
                <a
                  href={`/problems/catalogue/${problem.id}`}
                  class="group pressable tap-target hover-underline md:col-span-3 self-start md:justify-self-end flex items-center gap-2 text-sm"
                >
                  <Icon
                    name="arrow-east"
                    class="size-4 motion-safe:group-hover:translate-x-1 transition-transform duration-200 ease-(--ease-out)"
                  />
                  Read how it was built
                </a>
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
